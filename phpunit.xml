<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The address the tests are written for, whatever the .env of this machine says (it may be a local name over
             https, behind a proxy of its own). -->
        <env name="APP_URL" value="http://localhost:8020"/>
        <env name="TRUSTED_PROXIES" value=""/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Tests wipe their database: point them at a dedicated SQL Server test
             database, never the application database from .env. -->
        <env name="DB_CONNECTION" value="sqlsrv"/>
        <env name="DB_HOST" value="(localdb)\MSSQLLocalDB"/>
        <env name="DB_PORT" value=""/>
        <env name="DB_DATABASE" value="MTI Radio Management Test"/>
        <env name="DB_USERNAME" value="null"/>
        <env name="DB_PASSWORD" value="null"/>
        <env name="DB_ENCRYPT" value="no"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Tests never talk to Microsoft: no application secret, no SharePoint folder from .env. -->
        <env name="AZURE_CLIENT_SECRET" value=""/>
        <env name="MS_GRAPH_CLIENT_SECRET" value=""/>
        <env name="SHAREPOINT_COF_SCAN_URL" value=""/>
        <env name="SHAREPOINT_ICT_MASTERLIST_URL" value=""/>
        <!-- Nor to Snipe-IT. -->
        <env name="SNIPEIT_URL" value=""/>
        <env name="SNIPEIT_TOKEN" value=""/>
        <!-- Nor to the HR database or Active Directory, whatever .env holds for them. -->
        <env name="HR_DB_HOST" value=""/>
        <env name="HR_DB_DATABASE" value=""/>
        <env name="HR_DB_USERNAME" value=""/>
        <env name="HR_DB_PASSWORD" value=""/>
        <env name="EMPLOYEE_DIRECTORY_CONNECTION" value="hr"/>
        <env name="LDAP_URL" value=""/>
        <env name="LDAP_BIND_DN" value=""/>
        <env name="LDAP_BIND_PASSWORD" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
