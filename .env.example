APP_NAME="MTI Radio Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8020
APP_MERDEKA_URL=http://127.0.0.1:8000
# Site time (Morowali = WITA, UTC+8). The base app default is Asia/Jakarta (UTC+7).
APP_TIMEZONE=Asia/Makassar
# Port for `php artisan serve`
SERVER_PORT=8020
# Port docker-compose.yml publishes the container on: year, month and number of the app (26101 = 2026, October,
# the first app of that month). Only to be set when it has to be another one.
# DOCKER_PORT=26101
# Behind a reverse proxy that ends HTTPS (e.g. Nginx Proxy Manager in front of the Docker container): the addresses
# the proxy reaches the app from, comma separated (addresses or ranges such as 172.16.0.0/12). Not "*". Leave it
# empty when the app is opened directly.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE="MTI Radio Management"
DB_USERNAME=sa
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Microsoft (Entra ID) SSO. AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID / AZURE_REDIRECT_URI work too.
# The redirect URI must be registered in the Entra app (platform "Web"), and the app must be opened
# on the same host (http://localhost:8020, not http://127.0.0.1:8020).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_SSO_REDIRECT_URI=http://localhost:8020/auth/microsoft/callback

# Menu "COF Scan": the SharePoint folder to show. Open the folder in the browser, copy the
# address from the address bar (".../Forms/AllItems.aspx?id=...") and paste it between the
# quotes. Do not use a link made with "Copy link" / "Share": such a link gives access to
# whoever holds it. The folder is read with the Entra app above, which needs the application
# permission Sites.Read.All with admin consent.
SHAREPOINT_COF_SCAN_URL=""
# Menu "ICT Masterlist": the Excel workbook to show. Open the workbook in the browser (Excel for
# the web), copy the address from the address bar (".../_layouts/15/Doc.aspx?sourcedoc=...") and
# paste it between the quotes.
SHAREPOINT_ICT_MASTERLIST_URL=""
# Minutes a folder listing or a workbook that was read is kept before SharePoint is asked again, and
# how long a workbook that could not be read is not downloaded again.
SHAREPOINT_DOCS_CACHE_MINUTES=10

# "Find employee" in the form of a user (User Management): the HR database, read only. Without HR_DB_HOST the
# search is not shown and a user is typed by hand. A login that may only read the staff number, the name and
# the work address is enough.
HR_DB_HOST=
HR_DB_PORT=1433
HR_DB_DATABASE=
HR_DB_USERNAME=
HR_DB_PASSWORD=
HR_DB_ENCRYPT=false
HR_DB_TRUST_SERVER_CERTIFICATE=true
# The table (better: a view with only these three columns) and what its columns are called.
EMPLOYEE_DIRECTORY_TABLE=employee_directory
EMPLOYEE_DIRECTORY_ID_COLUMN=employee_id
EMPLOYEE_DIRECTORY_NAME_COLUMN=name
EMPLOYEE_DIRECTORY_EMAIL_COLUMN=email
# Only addresses in these domains are offered (comma separated): others cannot sign in with Microsoft here.
EMPLOYEE_DIRECTORY_DOMAINS=merdekabattery.com

# Signing in with the Active Directory password, for accounts that have a directory username (sign-in method
# "LDAP" in User Management). Without LDAP_URL and LDAP_BIND_DN that method is not offered. The PHP ldap
# extension is not needed. LDAP_URL reads ldaps://host (or ldap://host, which is then encrypted with StartTLS);
# LDAP_BIND_DN is a service account that only has to read.
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE=            (default: LDAP_BASE_DN)
# LDAP_USER_SEARCH_FILTER="(sAMAccountName={username})"
LDAP_TIMEOUT=5
# Keep this true. False only while the certificate of the domain controller comes from a CA this server does
# not trust yet: without the check, whoever answers the connection receives the password that is typed.
# LDAP_CA_CERT is the full path of that CA's certificate (a PEM file); with it the check can be on.
LDAP_TLS_VERIFY=true
# LDAP_CA_CERT=
